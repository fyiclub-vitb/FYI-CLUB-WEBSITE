# ==============================================================================
# FYI Club Website - Firebase & App Environment Configuration
# ==============================================================================
# Instructions:
# 1. Create a file named `.env` in the root directory (same folder as package.json)
# 2. Paste the values below with your Firebase Project Web App Credentials
# 3. Note: `.env` is automatically ignored by git and will NEVER be pushed to GitHub
# ==============================================================================

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=fyiclubvitbpl.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fyiclubvitbpl
VITE_FIREBASE_STORAGE_BUCKET=fyiclubvitbpl.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YourSenderIdHere
VITE_FIREBASE_APP_ID=1:YourAppIdHere
VITE_RECAPTCHA_SITE_KEY=YourReCaptchaV3SiteKeyHere

# Production Site URL
VITE_SITE_URL=https://fyiclubvitbpl.web.app

